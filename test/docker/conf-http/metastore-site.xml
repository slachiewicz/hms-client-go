<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Enables Thrift-over-HTTP on the standalone metastore (SPEC.md §2.1, §3.2),
  for the apache/hive:4.2.1 HTTP-mode integration job.

  The apache/hive Docker Hub image documents no environment-variable
  convention for setting individual hive-site properties (only SERVICE_OPTS
  Java -D system properties and HIVE_CUSTOM_CONF_DIR for mounting whole
  config files); a -D system property is not reliably honored by
  MetastoreConf for every key, so this file is mounted instead via
  HIVE_CUSTOM_CONF_DIR, per that image's documented convention.

  Both the standalone-metastore property name and its "hive."-prefixed
  legacy alias are set, since HiveConf/MetastoreConf recognizes either
  depending on version.
-->
<configuration>
  <property>
    <name>metastore.server.thrift.transport.mode</name>
    <value>http</value>
  </property>
  <property>
    <name>hive.metastore.server.thrift.transport.mode</name>
    <value>http</value>
  </property>
  <property>
    <name>metastore.server.thrift.http.path</name>
    <value>metastore</value>
  </property>
  <property>
    <name>hive.metastore.server.thrift.http.path</name>
    <value>metastore</value>
  </property>
</configuration>
